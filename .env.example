# InfraScan Environment Configuration Template
# NOTE: No default credentials anywhere in code or documentation (Section 0.3, 0.4).

# Application Environment
ENVIRONMENT=development
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
SUPPORT_EMAIL=support@infrascan.local

# Security & Tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_secure_random_jwt_secret
COOKIE_SECURE=false

# Database Configuration (PostgreSQL 16 + PostGIS)
# In local dev without Docker, fallback to sqlite:///./infrascan_dev.db is supported
DATABASE_URL=postgresql+asyncpg://infrascan_app:replace_with_db_password@localhost:5432/infrascan_db

# Redis (Queue, Cache, Rate Limits)
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3 compatible)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_minio_secret_key
MINIO_BUCKET=infrascan-media
MINIO_SECURE=false

# SMTP Configuration (Mailpit in development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@infrascan.local
SMTP_STARTTLS=false

# OAuth2 Authentication Providers (Leave empty if unconfigured)
# Rule 10: Buttons appear ONLY for configured providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
